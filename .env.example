# Settings for development. Copy this file to ".env" (which Git ignores).
# Every setting is optional; the values here are examples, not secrets.

# Show detailed error pages and serve styles without a build step. Never on a real installation.
BLABTODO_DEBUG=1

# Where the database, photos and backups live. Default: the "data" folder next to manage.py.
# BLABTODO_DATA_DIR=./data

# Extra host names the app should answer to, separated by commas.
# Home-network addresses and names such as "homeassistant.local" work without this.
# BLABTODO_ALLOWED_HOSTS=tasks.example.org

# Needed only when the app is reached through HTTPS on another name (a reverse proxy).
# BLABTODO_TRUSTED_ORIGINS=https://tasks.example.org

# Default: the TZ variable of the system, else Europe/Prague.
# BLABTODO_TIME_ZONE=Europe/Prague

# Default: created on first start and kept in the data folder.
# BLABTODO_SECRET_KEY=replace-with-a-long-random-text
