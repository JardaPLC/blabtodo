# Czech translation of blabtodo.
#
# The texts in the code are English; this file gives the Czech for each of them.
#
# To see which texts are missing here or no longer used:
#     uv run python tools/check_texts.py
# After changing this file:
#     uv run python tools/compile_translations.py
msgid ""
msgstr ""
"Project-Id-Version: blabtodo\n"
"Report-Msgid-Bugs-To: \n"
"Language: cs\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
